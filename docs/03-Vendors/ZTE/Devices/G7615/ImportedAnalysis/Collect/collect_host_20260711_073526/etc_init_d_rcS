#!/bin/sh
#	$Id: rcS,v 1.7 2007/10/25 21:58:06 jwessel Exp $
# This is a minmal rcS file for target startup
# Make sure that /proc is mounted.
mount -a

#
#	Assign an address to the loopback device.
#
PATH="/sbin:/usr/sbin:/usr/bin:/bin:/dbus/bin:/dbus/sbin:/dbus/usr/bin:/dbus/usr/sbin:/usr/ovs/bin:/usr/ovs/sbin:/var/tmp/wireless"
#LD_LIBRARY_PATH="/usr/lib/glib-2.0:/usr/ovs/lib"
LD_LIBRARY_PATH="/lib:/usr/lib:/usr/lib/glib-2.0"
runlevel=S
prevlevel=N
umask 022
export PATH runlevel prevlevel LD_LIBRARY_PATH

export OVS_PATH="/usr/ovs"
export OVSDB_PATH="/userconfig/cfg"
export OVS_RUNDIR="/var/ovs/run"
export CFGDB="$OVSDB_PATH/conf.db"

export OVSDB_SERVER=$OVS_PATH/sbin/ovsdb-server
export OVS_VSWITCHD=$OVS_PATH/sbin/ovs-vswitchd
export OVSDB_TOOL=$OVS_PATH/bin/ovsdb-tool

#
#	Source defaults.
#
. /etc/default/rcS
export VERBOSE

. /etc/default/S00tagparam

#
#	Trap CTRL-C &c only in this shell so we can interrupt subprocesses.
#
trap ":" INT QUIT TSTP

#
#	check and mount /userconfig
#
. /etc/default/S01userconfig

if [ -f /userconfig/upgrade_status ]; then
bsp_upgrade_status=`cat /userconfig/upgrade_status`
echo "bsp_upgrade_status is $bsp_upgrade_status"
#6 represent upgrading,then power off
if [ $bsp_upgrade_status -eq 8 ]; then	
    rm -rf /userconfig/upgrade_status
    if [ -f /opt/upt/apps/saf-starttime ]; then
        rm -rf /opt/upt/apps/saf-starttime
    fi
fi
fi

mount -o loop /kmoduletmp/kmodule.img /kmodule -t squashfs

#
#	Call all parts in order.
#
for i in /etc/rcS.d/S??*
do
	# Ignore dangling symlinks for now.
	[ ! -f "$i" ] && continue

	case "$i" in
		*.sh)
			# Source shell script for speed.
			(
				trap - INT QUIT TSTP
				set start
				. $i
			)
			;;
		*)
			# No sh extension, so fork subprocess.
			$i start

			;;
	esac
done

#
# Create log flag file
#
if [ ! -f /userconfig/cfg/flag_usrfs ]; then
	echo `ls -l /userconfig/`  
	echo `date` > /userconfig/cfg/flag_usrfs
fi

#
# Resume default configuration file
# 0 - Default, 1 - Russia, 2 - Lithuania, 3 - Romania, 4 - Singapore
#
USR_DB_CFG_TYPE_MAX=300
USR_DB_DEFAULT_CFG_XML=/userconfig/cfg/db_default_cfg.xml
USR_DB_USER_CFG_XML=$USR_DB_USER_CFG_XML
USR_DB_BACKUP_CFG_XML=/userconfig/cfg/db_backup_cfg.xml
USR_CFG_TYPE_FILE=/userconfig/flag_type
USR_CFG_ERR_FILE=/userconfig/regioncode_error.log

