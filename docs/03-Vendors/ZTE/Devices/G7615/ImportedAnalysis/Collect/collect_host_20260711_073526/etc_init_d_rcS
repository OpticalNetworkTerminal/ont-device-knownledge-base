ETC_DB_REGIONCODE=/etc/init.d/regioncode

# 如果db_default_xxx_cfg.xml文件不存在，则读取gpon、epon标志，如果是gpon，则拷贝db_default_xxx_gpon.xml,如果是epon，则拷贝db_default_xxx_egpon.xml
# 该部分修改针对EPON和GPON合一版本
#PON_MODE_FILE=/proc/capability/ponmode 
copy_cfgfile_by_ponmode() {
	regionname=$1
	if [ -z  "$regionname" ]; then
		return 1
	fi
	#ponmod=`cat $PON_MODE_FILE | grep 'ponmode' | sed -e 's/^ponmode: /\1/'`
	#EPON&GPON union new ver
	ponmode=`cat /proc/capability/portinfo | grep 'wan' | cut -d ':' -f 2`
	# emsk=$((16#1a0))
	# gmsk=$((16#e40))
	# gpon mask : 0x40 0x200 0x400 0x800
	# epon mask : 0x20 0x80  0x100
	echo "ponmode is $ponmode"
	for e in 32 128 256
	do
		if [ $e -eq $ponmode ]
		then
			 echo "load db_default_${regionname}_epon_cfg.xml"
			 ETC_DB_CFG_PON_XML=/etc/db_default_${regionname}_epon_cfg.xml
			 break
		fi
	done

	for g in 64 512 1024 2048
	do
		 if [ $g -eq $ponmode ]
		 then
			  echo "load db_default_${regionname}_gpon_cfg.xml"
			  ETC_DB_CFG_PON_XML=/etc/db_default_${regionname}_gpon_cfg.xml
			  break
		 fi
	done

	if [ -f "$ETC_DB_CFG_PON_XML" ]; then
		busybox cmp $ETC_DB_CFG_PON_XML $USR_DB_DEFAULT_CFG_XML 1>/dev/null 2>&1
		if [ $? -ne 0 ]; then
			echo "USR_DB_DEFAULT_CFG is different from ETC_DB_CFG!"
			echo "cp $ETC_DB_CFG_PON_XML to $USR_DB_DEFAULT_CFG_XML "
			cp -f $ETC_DB_CFG_PON_XML  $USR_DB_DEFAULT_CFG_XML
		else
			echo "USER_CFG is same as ETC_CFG, donot need copy"
		fi
	else
		echo "ponmode=cat /proc/capability/portinfo | grep 'wan' rcS read failed!"
		return 1
	fi
}

copy_CFGFILE_by_REGIONCODE() {
	regioncode=$1
	regionname=`busybox awk -F: -v regioncode="$regioncode" '$1==regioncode {print $2}' $ETC_DB_REGIONCODE`
	echo "==================================================================="
	echo "region code:$regioncode"
	echo "region name:$regionname"
	ETC_DB_CFG_XML=/etc/db_default_${regionname}_cfg.xml
	if [ -f "$ETC_DB_CFG_XML" ]; then
		busybox cmp $ETC_DB_CFG_XML $USR_DB_DEFAULT_CFG_XML 1>/dev/null 2>&1
		if [ $? -ne 0 ]; then
			echo "USR_DB_DEFAULT_CFG is different from ETC_DB_CFG!"
			echo "cp $ETC_DB_CFG_XML to $USR_DB_DEFAULT_CFG_XML "
			cp -f $ETC_DB_CFG_XML  $USR_DB_DEFAULT_CFG_XML
		else
			echo "USER_CFG is same as ETC_CFG, donot need copy"
		fi
	else
		copy_cfgfile_by_ponmode $regionname # 函数调用
		if [ $? -eq 1 ]; then
			echo "$regioncode unsupported!! ETC_CFG not exist! " > $USR_CFG_ERR_FILE
		fi
	fi
	echo "==================================================================="
}

if [ ! -f $USR_DB_DEFAULT_CFG_XML ]; then
	cp -f $ETC_DB_DEFAULT_CFG_XML $USR_DB_DEFAULT_CFG_XML
	if [ -f $USR_DB_BACKUP_CFG_XML ]; then
		echo "  $USR_DB_BACKUP_CFG_XML found, deleted"
		rm -f $USR_DB_BACKUP_CFG_XML
	fi
fi
  
if [ ! -f $USR_CFG_TYPE_FILE ]; then
	echo "current : 0" > $USR_CFG_TYPE_FILE
	cp -f $ETC_DB_DEFAULT_CFG_XML $USR_DB_DEFAULT_CFG_XML
else
	idx=`cat $USR_CFG_TYPE_FILE | grep 'current' | sed -e 's/^current \: /\1/'`
	if [ -n "$idx" ]; then
		copy_CFGFILE_by_REGIONCODE $idx
		
		if [ $idx -gt $USR_DB_CFG_TYPE_MAX ]; then
			echo "$idx unsupported!! out of bounds" > $USR_CFG_ERR_FILE
		fi
	else
		echo "cat $USR_CFG_TYPE_FILE failed!" > $USR_CFG_ERR_FILE
	fi
	
	idx=`cat $USR_CFG_TYPE_FILE | grep 'current' | sed -e 's/^current \: /\1/'`
	if [ $idx -eq 0 ]; then
		busybox cmp $ETC_DB_DEFAULT_CFG_XML $USR_DB_DEFAULT_CFG_XML 1>/dev/null 2>&1
		if [ $? -ne 0 ]; then
			echo "USR_DB_DEFAULT_CFG is different from ETC_DB_CFG!"
			echo "cp $ETC_DB_DEFAULT_CFG_XML to $USR_DB_DEFAULT_CFG_XML "
			cp -f $ETC_DB_DEFAULT_CFG_XML $USR_DB_DEFAULT_CFG_XML
		else
			echo "USER_CFG is same as ETC_CFG, donot need copy"
		fi
	fi
fi
echo "  Database default setting is [`cat $USR_CFG_TYPE_FILE`]"
if [ ! -f /opt/cu/apps/CuInformUpper ]; then
mkdir -p /opt/cu/apps/CuInformUpper
fi
if [ ! -f /opt/cu/apps/CuInformWork ]; then
mkdir -p /opt/cu/apps/CuInformWork
fi

count=`ls -l /opt/cu/apps/CuInformWork/work/|wc -l`
if [ $count -gt 0 ]; then
    rm -rf /opt/cu/apps/CuInformWork/work/*
fi

host_name=`cat /proc/csp/boardtype`
mount -t overlay overlay -o lowerdir=/usr/pre_plugin/pre_CuInform_$host_name,upperdir=/opt/cu/apps/CuInformUpper,workdir=/opt/cu/apps/CuInformWork /CuInform

if [ ! -f /CuInform/tmp ]; then
mkdir -p /CuInform/tmp
fi
mount -t tmpfs -o rw,nosuid,size=5240k tmpfs /CuInform/tmp

#
# copy some files to /var/tmp/linux-igd, used by UPNP and SNTP
#
mkdir -p /var/tmp/linux-igd
cp -f  /etc/gatedesc.skl     /var/tmp/linux-igd/gatedesc.skl
cp -f  /etc/gateinfoSCPD.xml /var/tmp/linux-igd/gateinfoSCPD.xml
cp -f  /etc/gateicfgSCPD.xml /var/tmp/linux-igd/gateicfgSCPD.xml
cp -f  /etc/gateconnSCPD.xml /var/tmp/linux-igd/gateconnSCPD.xml

#
# auto-start dbus
#
. /etc/init.d/dbus-rcS

supportkmemleakstr=`grep kmemleak_scan_thread /proc/kallsyms`
if [ x != x"${supportkmemleakstr}" ];then
    echo "==== support kmemleak, start mount ===="
    mount -t debugfs nodev /sys/kernel/debug
else
    echo "==== not support kmemleak ===="
fi

echo "exec_getkerpdinfo_start"
getkerpdinfo
echo "exec_getkerpdinfo_end"

regionidx=`cat $USR_CFG_TYPE_FILE | grep 'current' | sed -e 's/^current \: /\1/'`
if [ $regionidx == "334" ];then
echo 1 > /sys/devices/system/cpu/cpufreq/boost
echo 1200000 > /sys/devices/system/cpu/cpu0/cpufreq/scaling_setspeed
fi

if [ $regionidx != "334" ];then
lowpower rgmii
lowpower ipsec
#lowpower nand
#lowpower sdio
#lowpower i2s
#lowpower tdm0
fi
#
# auto-start pc
#
pc&

#
# hostname
#
hostname -F /proc/csp/boardtype

